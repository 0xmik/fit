# caltrack environment — copy to .env, fill in, then `set -a; source .env; set +a`
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
ANTHROPIC_API_KEY=sk-ant-...
# Sonnet-tier model for food estimation (check https://docs.claude.com for current ids)
ANTHROPIC_MODEL=claude-sonnet-5
# your chat id — /start the bot once, it replies with the id; 0 = accept first user
TELEGRAM_CHAT_ID=0
